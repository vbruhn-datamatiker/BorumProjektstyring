@page
@model BorumProjektstyring.Pages.ChangePasswordModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skift adgangskode - Borum Byggerådgivning ApS</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <header class="login-header">
        <div class="login-header__company">BORUM BYGGERÅDGIVNING ApS</div>
        <span class="login-header__support">Sikker adgang</span>
    </header>

    <main class="login-main">
        <section class="login-card change-password-card" aria-labelledby="change-password-title">
            <h1 id="change-password-title">Skift adgangskode</h1>
            <p class="login-card__intro">Da det er første gang du logger ind, skal du vælge en ny adgangskode, før du kan fortsætte.</p>

            <form method="post" class="login-form" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-form__field">
                    <label asp-for="NewPassword">Ny adgangskode</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="login-validation"></span>
                </div>

                <div class="login-form__field">
                    <label asp-for="ConfirmPassword">Bekræft adgangskode</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="login-validation"></span>
                </div>

                <button class="login-button" type="submit">Gem adgangskode</button>
            </form>
        </section>
    </main>

    <footer class="login-footer">
        <span>ARBEJDSRUM</span><span>Projekt- og tidsstyring</span>
    </footer>
</body>
</html>

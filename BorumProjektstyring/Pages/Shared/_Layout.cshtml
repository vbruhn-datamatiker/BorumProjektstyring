<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BorumProjektstyring</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BorumProjektstyring.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <aside class="sidebar">
            <header class="sidebar-header">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ARBEJDSRUM</a>
                <button class="workspace-switcher" type="button">Acme arbejdsrum <span aria-hidden="true">⌄</span></button>
            </header>
            <nav aria-label="Primær navigation">
                <h2>Arbejde</h2>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/CustomerPage">Kunder</a></li>
                    <li class="nav-item"><a class="nav-link active" asp-area="" asp-page="/ProjectPage">Projekter</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Opgaver/Index">Opgaver</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Tidsregistrering/Index">Tidsregistreringer</a></li>
                </ul>
                <hr />
                <h2>Kartotek</h2>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="#">Lokationer</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Brugere</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Fravær</a></li>
                </ul>
            </nav>
            <section class="sidebar-customer">
                <h2>Aktuel kunde</h2>
                <strong>Acme Industries</strong>
                <span>Kontoretablering</span>
            </section>
            <footer class="sidebar-footer">
                <a href="#">Hjælp og support</a>
                <span>Alex Morgan <span aria-hidden="true">·</span> Konto</span>
            </footer>
        </aside>
        <div class="main-content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted">
                <div>
                    &copy; 2026 - BorumProjektstyring - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
